# ─── LLM Provider ───────────────────────────────────────────────────────────
# Set to one of: groq | gemini | openrouter
LLM_PROVIDER=groq

# ─── Groq (free tier) ────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=
# Optional: override the default model (llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# ─── Google Gemini (free tier) ───────────────────────────────────────────────
# Get a free key at https://aistudio.google.com
GOOGLE_API_KEY=
# Optional: override the default model (gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# ─── OpenRouter (free model pool) ────────────────────────────────────────────
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=
# Optional: override the default free model
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
